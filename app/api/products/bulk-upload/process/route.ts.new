import { NextRequest, NextResponse } from "next/server"
import * as XLSX from "xlsx"
import { connectToDatabase } from "@/lib/mongodb"
import EyewearProduct from "@/models/EyewearProduct"

export async function POST(request: NextRequest) {
  try {
    await connectToDatabase()
    
    const formData = await request.formData()
    const file = formData.get('file') as File
    
    if (!file) {
      return NextResponse.json({ error: "No file uploaded" }, { status: 400 })
    }

    // Validate file type
    if (!file.name.match(/\.(xlsx|xls)$/)) {
      return NextResponse.json({ error: "Please upload a valid Excel file (.xlsx or .xls)" }, { status: 400 })
    }

    const buffer = Buffer.from(await file.arrayBuffer())
    const workbook = XLSX.read(buffer, { type: 'buffer' })

    let productsProcessed = 0
    let errorCount = 0
    let errors: any[] = []

    console.log("Available sheets:", workbook.SheetNames)

    // Process Products Sheet (check for sheet named "FR SG" as per specification)
    const productSheetName = workbook.SheetNames.includes('FR SG') ? 'FR SG' : null;
    
    if (productSheetName) {
      const sheet = workbook.Sheets[productSheetName];
      if (!sheet) {
        throw new Error('Sheet "FR SG" not found');
      }

      // Convert sheet to JSON - exactly as in bulk-upload.js
      const rows = XLSX.utils.sheet_to_json(sheet, { header: 1 });

      // Headers are in row 2 (index 1), data starts from row 3 (index 2)
      const headers = rows[1];
      const dataRows = rows.slice(2);

      let currentParent = null;
      const productsToInsert = [];

      // Process each row according to bulk-upload.js
      for (let i = 0; i < dataRows.length; i++) {
        const row = dataRows[i];
        const rowNumber = i + 3; // Excel row number (accounting for header rows)
        
        try {
          if (!row || row.length === 0) continue; // Skip empty rows
          
          const rowData = {};
          headers.forEach((header, index) => {
            rowData[header] = row[index] || '';
          });

          if (rowData['Product Variables'] === 'Parent') {
            currentParent = rowData;
          } else if (rowData['Product Variables'] === 'Child' && currentParent) {
            // Merge parent and child data, child overrides parent where present
            const productData = { ...currentParent, ...rowData };

            // Map fields to MongoDB document
            const product = {
              brand_name: productData['BRAND NAME'],
              product_title: productData['TITLE'] || '',
              product_description: productData['Description'] || '',
              print_name: productData['PRINT NAME'],
              product_type: productData['Product type'],
              sku: productData['SKU'],
              barcode: productData['Barcode'],
              color_code: productData['COLOR CODE'],
              color: productData['COLOR'],
              category: (productData['Category'] || '').toLowerCase(),
              weight: productData['WEIGHT'],
              size: productData['SIZE'],
              material: productData['MATERIAL'],
              shape: productData['SHAPE'],
              frame_dimension: productData['FRAME DIMENSION'],
              frame_type: productData['FRAME TYPE'],
              gender: productData['GENDER'],
              weight_group: productData['WEIGHT GROUP'],
              age_group: productData['Age group'],
              frame_width: productData['FRAME WIDTH'],
              lenses_supported: productData['LENSES Supported'],
              collection_type: productData['COLLECTION type'],
              unit: productData['UNIT'],
              tags: productData['TAG'] ? productData['TAG'].split(',') : [],
              tax: productData['TAX'],
              start_qty: Number(productData['Start QTY']) || 0,
              sale_price: Number(productData['SALE PRICE']) || 0,
              mrp: Number(productData['MRP/OLD PRICE']) || 0,
              images: [
                productData['IMAGE 1'], productData['IMAGE 2'], productData['IMAGE 3'],
                productData['IMAGE 4'], productData['IMAGE 5'], productData['IMAGE 6']
              ].filter(Boolean),
              short_technical_information: productData['SHORT Technical Information'],
              long_technical_information: productData['LONG Technical Information'],
              publish: productData['Publish'],
              show_on_website: productData['Show on Website'],
              where_to_show: productData['Where to Show'],
              incentive_for_salesman: productData['Incentive for salesman'],
              loyalty_pts: productData['Loyalty pts'],
              related_products: productData['Related Products'] ? productData['Related Products'].split(',') : [],
              keywords: productData['Keywords'],
              meta_description: productData['Description (1)'] || '', // Second Description
              meta_title: productData['Title (1)'] || '', // Second Title
              created_at: new Date(),
              updated_at: new Date(),
              
              // Map fields to our MongoDB schema
              name: productData['TITLE'] || productData['BRAND NAME'],
              title: productData['TITLE'],
              brandName: productData['BRAND NAME'],
              printName: productData['PRINT NAME'],
              price: Number(productData['SALE PRICE']) || 0,
              description: productData['Description'] || '',
              category: mapCategory(productData['Category']),
              productType: productData['Product type'] || 'Eyeglasses',
              variationType: 'Variable', // Since this is a parent-child model
              variationRole: rowData['Product Variables'],
              colorCode: productData['COLOR CODE'],
              colorName: productData['COLOR'],
              frameShape: productData['SHAPE'],
              stock: Number(productData['Start QTY']) || 0,
              inStock: Number(productData['Start QTY']) > 0,
              isPublished: productData['Publish'] === 'YES',
              showOnWebsite: productData['Show on Website'] === 'YES',
              whereToShow: productData['Where to Show'] ? productData['Where to Show'].split(',') : [],
              loyaltyPoints: Number(productData['Loyalty pts']) || 0,
              metaKeywords: productData['Keywords'],
              metaDescription: productData['Description (1)'] || productData['Description'] || '',
              metaTitle: productData['Title (1)'] || productData['TITLE'] || '',
              
              // Enhanced image handling
              image: (productData['IMAGE 1'] && productData['IMAGE 1'].trim()) ? 
                productData['IMAGE 1'] : '/placeholder.svg',
            };
            
            // Handle duplicate Description and Title (assuming second occurrence is meta)
            if (headers.includes('Description') && headers.lastIndexOf('Description') !== headers.indexOf('Description')) {
              product.meta_description = productData[headers[headers.lastIndexOf('Description')]];
            }
            if (headers.includes('Title') && headers.lastIndexOf('Title') !== headers.indexOf('Title')) {
              product.meta_title = productData[headers[headers.lastIndexOf('Title')]];
            }
            
            productsToInsert.push(product);
          }
        } catch (error) {
          console.error(`Error processing row ${rowNumber}:`, error);
          errors.push({
            row: rowNumber,
            sheet: productSheetName,
            error: error instanceof Error ? error.message : 'Unknown error',
            sku: rowData?.['SKU'] || 'Unknown SKU'
          });
          errorCount++;
        }
      }

      // Insert or update products in MongoDB
      const results = { inserted: 0, updated: 0, errors: [] };
      
      for (const product of productsToInsert) {
        try {
          const existingProduct = await Product.findOne({ sku: product.sku });
          
          if (existingProduct) {
            // Update existing product
            await Product.updateOne(
              { sku: product.sku }, 
              { $set: { ...product, updatedAt: new Date() } }
            );
            results.updated++;
          } else {
            // Insert new product
            await Product.create(product);
            results.inserted++;
          }
          
          productsProcessed++;
        } catch (err) {
          console.error(`Error saving product with SKU ${product.sku}:`, err);
          errors.push({
            sku: product.sku,
            error: err instanceof Error ? err.message : 'Unknown database error'
          });
          errorCount++;
        }
      }
    }

    // Prepare response
    const total = productsProcessed + errorCount;
    const successMessage = `Successfully processed ${productsProcessed} products.`;
    const errorMessage = errorCount > 0 ? ` ${errorCount} errors occurred.` : '';

    return NextResponse.json({
      success: true,
      message: successMessage + errorMessage,
      productsProcessed,
      filtersProcessed: 0, // Removed filter processing per requirement
      errors: errorCount,
      errorDetails: errors.slice(0, 50), // Show first 50 errors
      total
    });

  } catch (error) {
    console.error("Bulk upload error:", error);
    return NextResponse.json({ 
      success: false,
      error: error instanceof Error ? error.message : "Failed to process bulk upload" 
    }, { status: 500 });
  }
}

// Function to map category names to valid enum values
const mapCategory = (category: string): string => {
  if (!category) return 'eyeglasses';
  const lowerCategory = category.toLowerCase();
  
  if (lowerCategory.includes('prescription') || lowerCategory.includes('eyeglass')) return 'prescription';
  if (lowerCategory.includes('sunglass')) return 'sunglasses';
  if (lowerCategory.includes('reading')) return 'reading';
  if (lowerCategory.includes('blue') && lowerCategory.includes('light')) return 'blue-light';
  if (lowerCategory.includes('fashion')) return 'fashion';
  
  return 'eyeglasses';
}
